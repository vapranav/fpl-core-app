{
  "manifest_version": 3,
  "name": "FPL Core – Copy FPL Token",
  "version": "1.0.0",
  "description": "Copy your Fantasy Premier League access token in one click, to unlock private team data in FPL Core.",
  "permissions": ["storage", "scripting", "webRequest", "clipboardWrite"],
  "host_permissions": ["https://fantasy.premierleague.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copy FPL token",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
