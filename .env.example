# Backend settings. Copy to backend/.env (or .env at the repo root, which
# docker compose also reads) and fill in what you need. Never commit .env.
DATABASE_URL=sqlite:///./fpl.db
SEASONS=
REFRESH_HOUR=8,18
REFRESH_MINUTE=5
ETL_ON_STARTUP_IF_EMPTY=true
ADMIN_TOKEN=

# LLM features (Claude). Paste your own key from https://console.anthropic.com
# (Settings -> API keys). Leave empty to run without LLM features.
ANTHROPIC_API_KEY=
# Optional: override the model.
# LLM_MODEL=claude-opus-5-5
